# AIS Plugin Production Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Environment setting
NODE_ENV=production
AIS_LOG_LEVEL=info

# Service ports
AIS_HEALTH_PORT=8080
AIS_METRICS_PORT=9090

# =============================================================================
# IMMUNITY SYSTEM CONFIGURATION
# =============================================================================

# Global immunity threshold (0.0 - 1.0)
AIS_IMMUNITY_THRESHOLD=0.8

# Enable extended immunities (truth, performance, coherence, dependencies)
AIS_EXTENDED_IMMUNITIES=true

# Performance targets
AIS_PERFORMANCE_TARGET_MS=30
AIS_MEMORY_LIMIT_MB=512
AIS_CPU_THRESHOLD=0.7

# Individual immunity weights
AIS_SECURITY_WEIGHT=1.0
AIS_TRUTH_WEIGHT=0.9
AIS_PERFORMANCE_WEIGHT=0.8
AIS_COHERENCE_WEIGHT=0.7
AIS_DEPENDENCIES_WEIGHT=0.6

# Violation handling
AIS_MAX_VIOLATIONS_PER_HOUR=50
AIS_VIOLATION_COOLDOWN_SECONDS=300
AIS_AUTO_RECOVERY_ENABLED=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Redis authentication
REDIS_HOST=ais-redis-service
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password-here

# JWT configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=15m
JWT_ALGORITHM=RS256

# API security
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100

# Encryption keys (base64 encoded)
MASTER_ENCRYPTION_KEY=base64-encoded-256-bit-key
DATA_ENCRYPTION_SALT=base64-encoded-salt

# TLS configuration
TLS_CERT_PATH=/etc/ssl/certs/ais-plugin.pem
TLS_KEY_PATH=/etc/ssl/private/ais-plugin.key
TLS_CA_PATH=/etc/ssl/certs/ca-bundle.pem

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus configuration
PROMETHEUS_URL=http://ais-prometheus:9090
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_RETENTION_TIME=7d

# Grafana configuration
GRAFANA_PASSWORD=your-grafana-admin-password-here
GRAFANA_URL=http://ais-grafana:3000

# Alerting
ALERT_WEBHOOK_URL=https://your-alerting-system.com/webhook
ALERT_EMAIL_FROM=noreply@claude-flow.com
ALERT_EMAIL_TO=alerts@claude-flow.com

# Log aggregation
LOG_AGGREGATION_ENABLED=true
LOG_AGGREGATION_URL=http://loki:3100
LOG_RETENTION_DAYS=30

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite configuration (for local storage)
SQLITE_DB_PATH=/app/data/ais-plugin.db
SQLITE_BACKUP_INTERVAL_HOURS=6

# Redis configuration (for caching and sessions)
REDIS_MAX_MEMORY=200mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_TIMEOUT=5000

# =============================================================================
# INFRASTRUCTURE CONFIGURATION
# =============================================================================

# Kubernetes configuration
K8S_NAMESPACE=claude-flow
K8S_SERVICE_ACCOUNT=ais-plugin
K8S_CLUSTER_NAME=production

# Container limits
CONTAINER_CPU_LIMIT=1000m
CONTAINER_MEMORY_LIMIT=512Mi
CONTAINER_CPU_REQUEST=100m
CONTAINER_MEMORY_REQUEST=128Mi

# Auto-scaling
HPA_MIN_REPLICAS=3
HPA_MAX_REPLICAS=10
HPA_TARGET_CPU_UTILIZATION=70
HPA_TARGET_MEMORY_UTILIZATION=80

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true

# Remote backup storage
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-west-2
BACKUP_GCS_BUCKET=your-gcs-bucket
BACKUP_AZURE_CONTAINER=your-azure-container

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================

# Audit logging
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_RETENTION_DAYS=90

# Compliance mode
COMPLIANCE_MODE=production
COMPLIANCE_FRAMEWORKS=soc2,gdpr,hipaa

# Data retention
DATA_RETENTION_DAYS=365
PII_ANONYMIZATION=true

# =============================================================================
# DEVELOPMENT AND DEBUGGING
# =============================================================================

# Debug settings (disable in production)
DEBUG_MODE=false
DEBUG_PORT=9229
DEBUG_METRICS_VERBOSE=false

# Performance profiling
PROFILING_ENABLED=false
PROFILING_INTERVAL_MS=10000

# Health check configuration
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=5000
HEALTH_CHECK_RETRIES=3

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================

# Claude Flow integration
CLAUDE_FLOW_API_URL=https://api.claude-flow.com
CLAUDE_FLOW_API_KEY=your-api-key-here

# External monitoring services
DATADOG_API_KEY=your-datadog-api-key
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
SENTRY_DSN=your-sentry-dsn

# Notification services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature toggles
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_REAL_TIME_ALERTS=true
FEATURE_AUTO_REMEDIATION=false
FEATURE_MACHINE_LEARNING=true

# Experimental features
EXPERIMENTAL_NEURAL_PATTERNS=false
EXPERIMENTAL_QUANTUM_IMMUNITY=false

# =============================================================================
# LOAD TESTING AND SIMULATION
# =============================================================================

# Load testing configuration
LOAD_TEST_ENABLED=false
LOAD_TEST_MAX_RPS=1000
LOAD_TEST_DURATION_MINUTES=10

# Agent simulation
SIMULATE_AGENTS=false
SIMULATE_AGENT_COUNT=100
SIMULATE_VIOLATION_RATE=0.05

# =============================================================================
# NOTES AND REMINDERS
# =============================================================================

# IMPORTANT SECURITY NOTES:
# 1. Change all default passwords and keys before production deployment
# 2. Use strong, randomly generated passwords (minimum 32 characters)
# 3. Store secrets in a secure secret management system (Vault, AWS Secrets Manager, etc.)
# 4. Enable encryption for sensitive data
# 5. Regularly rotate secrets and certificates
# 6. Monitor for unauthorized access attempts

# PERFORMANCE TUNING:
# 1. Adjust immunity thresholds based on your workload
# 2. Monitor resource usage and scale accordingly
# 3. Optimize Redis configuration for your use case
# 4. Enable compression and caching where appropriate
# 5. Set up proper load balancing

# MONITORING CHECKLIST:
# 1. Configure alerts for critical metrics
# 2. Set up log aggregation and analysis
# 3. Enable distributed tracing for debugging
# 4. Monitor business metrics (violation rates, agent performance)
# 5. Set up automated backup verification

# COMPLIANCE REQUIREMENTS:
# 1. Enable audit logging for all administrative actions
# 2. Configure data retention policies according to regulations
# 3. Implement proper access controls and authentication
# 4. Set up encrypted communication channels
# 5. Regular security assessments and penetration testing

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================

# Uncomment and modify for specific environments:

# Development environment
# NODE_ENV=development
# AIS_LOG_LEVEL=debug
# DEBUG_MODE=true

# Staging environment
# NODE_ENV=staging
# AIS_IMMUNITY_THRESHOLD=0.7
# FEATURE_ADVANCED_ANALYTICS=false

# Production environment
# NODE_ENV=production
# AIS_LOG_LEVEL=info
# DEBUG_MODE=false
# FEATURE_ADVANCED_ANALYTICS=true